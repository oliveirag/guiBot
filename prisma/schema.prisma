generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model GuildConfig {
  guildId         String   @id
  // Comma-separated module names. SQLite has no scalar lists.
  disabledModules String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Job {
  id        Int      @id @default(autoincrement())
  type      String
  guildId   String?
  // JSON-encoded payload.
  payload   String
  runAt     DateTime
  // pending | running | done | failed
  status    String   @default("pending")
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())

  @@index([status, runAt])
}

// Where a guild wants a repo's or project's events posted.
model DevFeed {
  id        Int      @id @default(autoincrement())
  guildId   String
  // github | jira
  source    String
  // GitHub "owner/repo" (lowercased) or Jira project key (uppercased).
  key       String
  channelId String
  createdAt DateTime @default(now())

  @@unique([guildId, source, key])
  @@index([source, key])
}

// Every normalized webhook event, notified or not. Senior Design reads these later.
model DevEvent {
  id         Int      @id @default(autoincrement())
  // "<source>:<delivery id>#<index>", unique so redeliveries are ignored.
  deliveryId String   @unique
  source     String
  kind       String
  key        String
  // GitHub login or Jira accountId of whoever triggered it.
  actor      String?
  actorName  String?
  title      String
  url        String?
  detail     String?
  // Commit count for pushes.
  count      Int?
  // "<workflow>@<branch>" for workflow runs, used to spot "back to green".
  stream     String?
  createdAt  DateTime @default(now())

  @@index([source, key, createdAt])
  @@index([actor, createdAt])
  @@index([source, key, stream])
}

// Per-guild dev module settings.
model DevSettings {
  guildId       String   @id
  // Role pinged when a workflow fails. Null means no ping.
  failureRoleId String?
  updatedAt     DateTime @updatedAt
}

// Senior Design: a member's GitHub and Jira identities, so stats can be credited to them.
model SdMember {
  guildId       String
  userId        String
  // Lowercased GitHub login.
  githubLogin   String?
  jiraEmail     String?
  // Jira webhooks identify people by accountId.
  jiraAccountId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@id([guildId, userId])
}

// Per-guild Senior Design settings.
model SdSettings {
  guildId            String   @id
  timezone           String   @default("America/New_York")
  // Where deadline reminders and the upcoming board post.
  deadlineChannelId  String?
  boardMessageId     String?
  standupChannelId   String?
  // Local "HH:MM".
  standupTime        String   @default("10:00")
  // Comma-separated weekdays, 0 = Sunday.
  standupDays        String   @default("1,2,3,4,5")
  standupWindowHours Int      @default(4)
  // Bumped on every standup change so jobs scheduled under old settings stop.
  standupVersion     Int      @default(0)
  digestChannelId    String?
  digestDay          Int      @default(5)
  digestTime         String   @default("17:00")
  digestVersion      Int      @default(0)
  // Adds an AI-written status paragraph to the digest.
  aiDigest           Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model SdDeadline {
  id        Int       @id @default(autoincrement())
  guildId   String
  title     String
  dueAt     DateTime
  createdBy String
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([guildId, doneAt, dueAt])
}

model SdStandup {
  id        Int              @id @default(autoincrement())
  guildId   String
  channelId String
  messageId String?
  // Local "YYYY-MM-DD" in the guild's timezone.
  day       String
  closesAt  DateTime
  closedAt  DateTime?
  createdAt DateTime         @default(now())
  entries   SdStandupEntry[]

  @@unique([guildId, day])
}

model SdStandupEntry {
  standupId Int
  standup   SdStandup @relation(fields: [standupId], references: [id], onDelete: Cascade)
  userId    String
  yesterday String
  today     String
  blockers  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@id([standupId, userId])
}

model SdMeeting {
  id          Int       @id @default(autoincrement())
  guildId     String
  channelId   String
  messageId   String?
  // Discord scheduled event, when the bot could create one.
  eventId     String?
  title       String
  location    String?
  startsAt    DateTime
  durationMin Int
  weekly      Boolean   @default(false)
  createdBy   String
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  rsvps       SdRsvp[]

  @@index([guildId, startsAt])
}

model SdRsvp {
  meetingId Int
  meeting   SdMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  // yes | maybe | no
  status    String
  updatedAt DateTime  @updatedAt

  @@id([meetingId, userId])
}

// Per-guild AI settings. AI only answers in listed channels.
model AiSettings {
  guildId         String   @id
  // Comma-separated channel ids where /ask and mentions stay quiet. On everywhere else.
  offChannelIds   String   @default("")
  cooldownSeconds Int      @default(20)
  updatedAt       DateTime @updatedAt
}

// A moderation action. Numbered per guild so mods can say "case 12".
model ModCase {
  id           Int       @id @default(autoincrement())
  guildId      String
  number       Int
  // ban | unban | kick | timeout | untimeout | warn
  action       String
  userId       String
  userTag      String?
  moderatorId  String
  reason       String?
  // Seconds, for temp bans and timeouts.
  duration     Int?
  expiresAt    DateTime?
  // Warns turn inactive when deleted or cleared.
  active       Boolean   @default(true)
  logChannelId String?
  logMessageId String?
  createdAt    DateTime  @default(now())

  @@unique([guildId, number])
  @@index([guildId, userId, action])
}

model ModNote {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  @@index([guildId, userId])
}

model ModSettings {
  guildId        String   @id
  // DM people when they're warned, timed out, kicked, or banned.
  dmOnAction     Boolean  @default(true)
  // Active warns that trigger escalation. Null means off.
  warnThreshold  Int?
  // timeout | kick | ban
  warnAction     String?
  // Seconds, for timeout or temp ban escalation.
  warnDuration   Int?
  updatedAt      DateTime @updatedAt
}

// Where each kind of log goes. Kinds: messages, members, roles, voice, modlog.
model LogRoute {
  guildId   String
  kind      String
  channelId String

  @@id([guildId, kind])
}

// One automod rule's settings. Rules: spam, duplicates, invites, links, words, mentions, caps, newaccount.
model AutomodRule {
  guildId  String
  rule     String
  enabled  Boolean @default(true)
  // delete | warn | timeout | kick. Message rules always delete the message first.
  action   String  @default("delete")
  // Rule-specific limit: messages (spam, duplicates), mentions, caps percent, account age in days.
  limit    Int?
  // Timeout length in seconds.
  duration Int?

  @@id([guildId, rule])
}

model AutomodSettings {
  guildId        String   @id
  // One banned word or phrase per line, lowercased.
  bannedWords    String   @default("")
  // Comma-separated domains the links rule lets through.
  allowedDomains String   @default("")
  exemptRoles    String   @default("")
  exemptChannels String   @default("")
  updatedAt      DateTime @updatedAt
}

// A message people click to give themselves roles.
model RolePanel {
  id          Int               @id @default(autoincrement())
  guildId     String
  channelId   String
  messageId   String?
  title       String
  description String?
  // buttons | select
  style       String            @default("buttons")
  // Members can hold only one of this panel's roles, like color roles.
  exclusive   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  options     RolePanelOption[]

  @@index([guildId])
}

model RolePanelOption {
  panelId Int
  panel   RolePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  roleId  String
  label   String
  // Unicode emoji or a custom emoji id.
  emoji   String?
  // Order on the panel.
  position Int      @default(0)

  @@id([panelId, roleId])
}

model ReactionRole {
  guildId   String
  channelId String
  messageId String
  // Unicode emoji or a custom emoji id.
  emoji     String
  roleId    String

  @@id([messageId, emoji])
  @@index([guildId])
}

// Roles given to everyone who joins. target: humans | bots
model AutoRole {
  guildId String
  roleId  String
  target  String

  @@id([guildId, roleId, target])
}

model WelcomeSettings {
  guildId           String   @id
  joinChannelId     String?
  joinMessage       String?
  joinEmbed         Boolean  @default(true)
  // Sent privately to new members. Null means off.
  dmMessage         String?
  leaveChannelId    String?
  leaveMessage      String?
  leaveEmbed        Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model SuggestionSettings {
  guildId   String   @id
  channelId String?
  // Open a discussion thread on each suggestion.
  threads   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Suggestion {
  id         Int              @id @default(autoincrement())
  guildId    String
  // Numbered per guild.
  number     Int
  authorId   String
  content    String
  // open | approved | denied | considered
  status     String           @default("open")
  reason     String?
  reviewerId String?
  channelId  String
  messageId  String?
  createdAt  DateTime         @default(now())
  votes      SuggestionVote[]

  @@unique([guildId, number])
}

model SuggestionVote {
  suggestionId Int
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  userId       String
  // 1 or -1
  value        Int

  @@id([suggestionId, userId])
}
